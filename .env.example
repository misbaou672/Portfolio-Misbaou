# URL publique du site, sans slash final.
# Consommee par le plugin `vite/seo.ts` : canonical, og:url, og:image, JSON-LD,
# robots.txt et sitemap.xml. A definir dans les variables d'environnement de
# l'hebergeur (Vercel > Settings > Environment Variables).
# Sans elle, le build retombe sur l'adresse Vercel de production et previent
# en console. A definir le jour ou un domaine personnel la remplace.
VITE_SITE_URL=https://portfolio-misbaou.vercel.app
